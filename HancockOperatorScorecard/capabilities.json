                },
                "labelBR": {
                    "type": { "text": true },
                    "rule": { "inputRole": "quadX", "output": { "property": "labelBR", "selector": ["person"] } }
                },
                "fillTL": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "fillTL", "selector": ["person"] } }
                },
                "fillTR": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "fillTR", "selector": ["person"] } }
                },
                "fillBL": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "fillBL", "selector": ["person"] } }
                },
                "fillBR": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "fillBR", "selector": ["person"] } }
                },
                "peerDotColor": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "peerDotColor", "selector": ["person"] } }
                },
                "focusDotColor": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "quadX", "output": { "property": "focusDotColor", "selector": ["person"] } }
                },
                "labelFontSize": { "type": { "formatting": { "fontSize": true } } }
            }
        },
        "summary": {
            "properties": {
                "title": {
                    "type": { "text": true },
                    "rule": { "inputRole": "summary", "output": { "property": "title", "selector": ["person"] } }
                },
                "boxColor": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "summary", "output": { "property": "boxColor", "selector": ["person"] } }
                },
                "textColor": {
                    "type": { "fill": { "solid": { "color": true } } },
                    "rule": { "inputRole": "summary", "output": { "property": "textColor", "selector": ["person"] } }
                }
            }
        },
        "text": {
            "properties": {
                "fontFamily": {
                    "type": { "formatting": { "fontFamily": true } },
                    "rule": { "inputRole": "headline", "output": { "property": "fontFamily", "selector": ["person"] } }
                },
                "headlineSize": { "type": { "formatting": { "fontSize": true } } },
                "sectionHeaderSize": { "type": { "formatting": { "fontSize": true } } },
                "tileValueSize": { "type": { "formatting": { "fontSize": true } } },
                "bodySize": { "type": { "formatting": { "fontSize": true } } }
            }
        }
    }
}
